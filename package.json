{
  "name": "boomerangeon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy-pages.mjs",
    "typecheck": "tsc --noEmit",
    "check-lobby": "node scripts/lobby-smoke.mjs",
    "check-hover": "node scripts/hover-smoke.mjs",
    "check-art": "node src/art/check.ts",
    "check-arenas": "esbuild src/demo/checkArenas.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/checkArenas.mjs && node node_modules/.cache/checkArenas.mjs",
    "check-songs": "esbuild src/audio/check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/checkSongs.mjs && node node_modules/.cache/checkSongs.mjs",
    "check-rules-audio": "node scripts/rules-audio-smoke.mjs",
    "render-music": "node scripts/render-music.mjs",
    "check-music": "node scripts/music-smoke.mjs",
    "check-characters": "node scripts/characters-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
